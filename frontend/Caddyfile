# SITE_ADDRESS: a domain (automatic HTTPS) or ":80" for plain HTTP on an IP.
{$SITE_ADDRESS::80} {
	# The app has no login of its own; gate everything here.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
