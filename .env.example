POSTGRES_PASSWORD=change-me
# A domain pointing at this server gives automatic HTTPS; leave as :80 for plain HTTP on the IP.
SITE_ADDRESS=:80
BASIC_AUTH_USER=reviewer
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Escape every $ as $$ when pasting into .env.
BASIC_AUTH_HASH=
# Briefing assistant. Free key: https://aistudio.google.com/apikey (leave empty to disable briefings).
GEMINI_API_KEY=
